APP_NAME="Buku Angkatan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Database — Supabase PostgreSQL
# ------------------------------------------------------------------
# Gunakan Transaction Pooler (port 6543) untuk runtime.
# Gunakan Direct connection (port 5432) untuk migration.
# ------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------
# Mail — Resend
# ------------------------------------------------------------------
MAIL_MAILER=resend
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bukuangkatan.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

# ------------------------------------------------------------------
# Sanctum — stateful domains (tanpa protokol)
# ------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# ------------------------------------------------------------------
# Cloudflare R2 (S3-compatible)
# ------------------------------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=buku-angkatan-assets
R2_ENDPOINT=
R2_PUBLIC_DOMAIN=
R2_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------
# Bootstrap auth data (dipakai seeder, JANGAN commit nilai asli)
# ------------------------------------------------------------------
ANGGATAN_PASSCODE=

VITE_APP_NAME="${APP_NAME}"
